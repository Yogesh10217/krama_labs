# Krama AI Backend Configuration Example

# Application settings
APP_NAME="Krama AI"
ENV=development
DEBUG=True
API_PREFIX=/api

# Server settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# File upload limits
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads
RESULTS_DIR=results

# LLM Providers ("gemini" | "openai" | "local")
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Local LLM endpoint settings (optional)
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen2.5-vl-7b

# Processing thresholds
DPI_FOR_PDF=200
OCR_LANGUAGE=en
HIGH_CONFIDENCE=0.90
MEDIUM_CONFIDENCE=0.75
LOW_CONFIDENCE=0.50
FLAG_THRESHOLD=0.60
FUZZY_MATCH_THRESHOLD=75

# Database Settings
DATABASE_URL=sqlite:///./krama_dev.db
DATABASE_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional future credentials (placeholders)
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=

# ─── Phase 2: Storage Provider ────────────────────────────────────────────────
# Active storage provider. Currently only "local" is supported.
# Future values: "s3", "minio", "gcs" (not yet implemented).
STORAGE_PROVIDER=local

# Base directory for local filesystem storage.
# IMPORTANT: In Docker/production, mount a persistent volume at this path.
# Do NOT rely on ephemeral container storage for production use.
STORAGE_ROOT=./storage

# --- AI EXTRACTION PROVIDERS ---
# Fallback chain (comma separated, e.g. rule,ollama,gemini,openai)
EXTRACTION_FALLBACK_ORDER=rule,ollama,gemini,openai
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_RETRY_COUNT=3

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- LOGGING ---
LOG_LEVEL=INFO

# ─── Phase 2: Upload Limits ───────────────────────────────────────────────────
# Maximum file size per individual upload, in MB.
MAX_UPLOAD_SIZE_MB=50

# Maximum number of files accepted in a single batch upload.
MAX_BATCH_FILES=20

# Maximum combined size of all files in a batch, in MB.
MAX_BATCH_TOTAL_SIZE_MB=500

# Streaming chunk size in bytes (default: 1 MB = 1048576 bytes).
UPLOAD_CHUNK_SIZE_BYTES=1048576

# ─── Phase 9: Workflow & Review Settings ─────────────────────────────────────
AUTO_APPROVAL_THRESHOLD=0.95
REQUIRE_REVIEW_FOR_DOCUMENT_TYPES=
CRITICAL_FIELDS=total,invoice_number,aadhaar_number,pan_number

