# Krama AI Backend Configuration Example

# Application settings
APP_NAME="Krama AI"
ENV=development
DEBUG=True
API_PREFIX=/api

# Server settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# File upload limits
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads
RESULTS_DIR=results

# LLM Providers ("gemini" | "openai" | "local")
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Local LLM endpoint settings (optional)
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen2.5-vl-7b

# Processing thresholds
DPI_FOR_PDF=200
OCR_LANGUAGE=en
HIGH_CONFIDENCE=0.90
MEDIUM_CONFIDENCE=0.75
LOW_CONFIDENCE=0.50
FLAG_THRESHOLD=0.60
FUZZY_MATCH_THRESHOLD=75

# Database Settings
DATABASE_URL=sqlite:///./krama_dev.db
DATABASE_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional future credentials (placeholders)
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=
